# Copy this file to .env and replace both secrets with long random values.
# Keep .env out of git; it contains local service credentials.
POSTGRES_DB=attendance_calls
POSTGRES_USER=attendance
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

MINIO_ROOT_USER=attendance_admin
MINIO_ROOT_PASSWORD=replace-with-a-different-long-random-password
MINIO_BUCKET=attendance-recordings
MINIO_ACCESS_KEY=attendance_app
MINIO_SECRET_KEY=replace-with-another-long-random-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
