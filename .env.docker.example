# Copy this file to .env and replace both secrets with long random values.
# Keep .env out of git; it contains local service credentials.
POSTGRES_DB=attendance_calls
POSTGRES_USER=attendance
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

MINIO_ROOT_USER=attendance_admin
MINIO_ROOT_PASSWORD=replace-with-a-different-long-random-password
MINIO_BUCKET=attendance-recordings
MINIO_ACCESS_KEY=attendance_app
MINIO_SECRET_KEY=replace-with-another-long-random-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Standalone backend container (Linux GCP VM uses host networking for VM ADC)
DATABASE_URL=postgres://attendance:replace-with-a-long-random-password@127.0.0.1:5432/attendance_calls
DEFAULT_ORGANIZATION_ID=athulya
GOOGLE_CLOUD_PROJECT=replace-with-your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
API_PORT=3000
APP_TIMEZONE=Asia/Kolkata
PUBLIC_DOMAIN=calls.example.com

# Vobiz; set callback URLs to the public HTTPS reverse-proxy routes on the VM.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_API_BASE_URL=https://api.vobiz.ai/api/v1
PUBLIC_BASE_URL=https://calls.example.com
VOBIZ_ANSWER_URL=https://calls.example.com/api/call-service/answer
VOBIZ_HANGUP_URL=https://calls.example.com/api/call-service/webhooks/call-status
VOBIZ_RECORDING_ALLOWED_HOSTS=api.vobiz.ai
VOBIZ_STREAM_SECRET=replace-with-a-long-random-secret
VOBIZ_MEDIA_PATH=/api/call-service/media

# Athulya internal attendance API. Leave blank only while API delivery is not configured.
ATTENDANCE_BACKEND_URL=
ATTENDANCE_BACKEND_TOKEN=
