# Copy this file to .env and replace both secrets with long random values.
# Keep .env out of git; it contains local service credentials.
POSTGRES_DB=attendance_calls
POSTGRES_USER=attendance
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

MINIO_ROOT_USER=attendance_admin
MINIO_ROOT_PASSWORD=replace-with-a-different-long-random-password
MINIO_BUCKET=attendance-recordings
MINIO_ACCESS_KEY=attendance_app
MINIO_SECRET_KEY=replace-with-another-long-random-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Standalone backend container (Linux GCP VM uses host networking for VM ADC)
DATABASE_URL=postgres://attendance:replace-with-a-long-random-password@127.0.0.1:5432/attendance_calls
DEFAULT_ORGANIZATION_ID=athulya
# Protects API key creation/list/revoke endpoints; never expose this as a public app setting.
API_KEY_ADMIN_TOKEN=replace-with-a-long-random-admin-secret
ATHULYA_CREDENTIALS_ENCRYPTION_KEY=replace-with-64-hex-characters
ATHULYA_MOCK_API_BASE_URL=
ATHULYA_MOCK_API_KEY=replace-with-a-long-random-test-key
ATHULYA_MOCK_PORT=4010
API_PORT=3000
APP_TIMEZONE=Asia/Kolkata
ATHULYA_AUTO_SYNC_SCAN_INTERVAL_MS=60000
ATHULYA_ATTENDANCE_TIMEOUT_MS=15000
PUBLIC_DOMAIN=calls.elvoryx.in

# ChiefVoice provides telephony, the live agent and post-call extraction.
# API key needs calls:write for outbound calls and webhooks:write to register the callback.
# Register CHIEFVOICE_WEBHOOK_CALLBACK_URL with PUT /v1/webhooks/post-call;
# copy its one-time signing_secret response into CHIEFVOICE_WEBHOOK_SECRET.
CHIEFVOICE_URL=https://core.elvoryx.in
CHIEFVOICE_API_KEY=
# Leave false to use this API key's default assigned templates.
CHIEFVOICE_USE_EXPLICIT_TEMPLATE_IDS=false
CHIEFVOICE_LIVE_TEMPLATE_ID=
CHIEFVOICE_POST_CALL_TEMPLATE_ID=
CHIEFVOICE_TEMPLATE_CHECK_IN_LIVE_ID=
CHIEFVOICE_TEMPLATE_CHECK_IN_POST_CALL_ID=
CHIEFVOICE_TEMPLATE_CHECK_OUT_LIVE_ID=
CHIEFVOICE_TEMPLATE_CHECK_OUT_POST_CALL_ID=
CHIEFVOICE_TEMPLATE_CARE_MANAGER_ESCALATION_LIVE_ID=
CHIEFVOICE_TEMPLATE_CARE_MANAGER_ESCALATION_POST_CALL_ID=
CHIEFVOICE_TEMPLATE_CHECK_IN_RETRY_LIVE_ID=
CHIEFVOICE_TEMPLATE_CHECK_IN_RETRY_POST_CALL_ID=
CHIEFVOICE_TEMPLATE_CHECK_OUT_RETRY_LIVE_ID=
CHIEFVOICE_TEMPLATE_CHECK_OUT_RETRY_POST_CALL_ID=
CHIEFVOICE_TEMPLATE_CHECK_IN_FOLLOW_UP_LIVE_ID=
CHIEFVOICE_TEMPLATE_CHECK_IN_FOLLOW_UP_POST_CALL_ID=
CHIEFVOICE_TEMPLATE_CHECK_OUT_FOLLOW_UP_LIVE_ID=
CHIEFVOICE_TEMPLATE_CHECK_OUT_FOLLOW_UP_POST_CALL_ID=
CHIEFVOICE_TIMEOUT_MS=20000
CHIEFVOICE_RECORDING_ALLOWED=false
CHIEFVOICE_POLL_INITIAL_MS=15000
CHIEFVOICE_POLL_INTERVAL_MS=15000
CHIEFVOICE_POLL_MAX_ATTEMPTS=60
CHIEFVOICE_CALL_FAILURE_MAX_ATTEMPTS=2
CHIEFVOICE_CALLER_ID=+91XXXXXXXXXX
ATHULYA_LATE_SCHEDULE_GRACE_MINUTES=2
CHIEFVOICE_WEBHOOK_SECRET=replace-with-the-webhook-signing-secret
CHIEFVOICE_WEBHOOK_CALLBACK_URL=https://calls.elvoryx.in/api/call-service/webhooks/chiefvoice
PUBLIC_BASE_URL=https://calls.elvoryx.in

# Athulya internal attendance API. Leave blank only while API delivery is not configured.
ATTENDANCE_BACKEND_URL=
ATTENDANCE_BACKEND_TOKEN=
