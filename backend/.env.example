# API-key admin secret protects key creation, listing and revocation.
API_KEY_ADMIN_TOKEN=replace-with-a-long-random-admin-secret

# PostgreSQL is the durable source of truth and job queue.
DATABASE_URL=postgres://user:password@localhost:5432/attendance_calls
APP_TIMEZONE=Asia/Kolkata

# Vobiz outbound calling. Use a secret manager in production.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=+91XXXXXXXXXX
VOBIZ_API_BASE_URL=https://api.vobiz.ai/api/v1
VOBIZ_ANSWER_URL=https://your-service.example.com/api/call-service/answer
# Set this as the Vobiz Voice Application Answer URL for inbound patient calls.
# Set the Vobiz Voice Application Answer URL to this POST endpoint:
# https://your-service.example.com/api/call-service/incoming/answer
VOBIZ_HANGUP_URL=https://your-service.example.com/api/call-service/webhooks/call-status
VOBIZ_RECORDING_ALLOWED_HOSTS=api.vobiz.ai
VOBIZ_STREAM_SECRET=replace-with-a-long-random-secret
VOBIZ_MEDIA_PATH=/api/call-service/media
DATA_RETENTION_DAYS=90
RETENTION_SCAN_INTERVAL_MS=3600000
INBOUND_RECORDING_MAX_BYTES=52428800
PUBLIC_BASE_URL=https://your-service.example.com

# Global outbound concurrency across all API/worker instances (PostgreSQL slots).
MAX_CONCURRENT_CALLS=20
CALL_CAPACITY_POLL_MS=2000
# Safety expiry for calls whose terminal Vobiz callback is lost.
CALL_SLOT_TTL_MINUTES=180

# S3-compatible MinIO recording storage.
# Platform mode records both call directions and stores a mixed WAV in MinIO.
RECORDING_MODE=platform
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=attendance-recordings
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SERVER_SIDE_ENCRYPTION=
MAX_RECORDING_DOWNLOAD_BYTES=104857600

# Vertex AI uses Application Default Credentials (ADC).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_CALL_MODEL=gemini-2.5-flash
VERTEX_SUMMARY_MODEL=gemini-2.5-flash
VERTEX_TRANSCRIPTION_MODEL=gemini-3.1-flash-lite
VERTEX_TRANSCRIPTION_LOCATION=global
VERTEX_TTS_MODEL=gemini-2.5-flash-preview-tts
VERTEX_LIVE_AUDIO_MODEL=gemini-live-2.5-flash-native-audio

# Dedicated inbound patient agent; its prompt is independent from attendance calls.
INBOUND_PATIENT_AGENT_NAME=Athulya Patient Care Assistant
INBOUND_PATIENT_AGENT_VOICE=
INBOUND_PATIENT_AGENT_PROMPT=

# Phone-call retry policy: 5 minutes, then 6, 7.2, ... up to 30 minutes.
CALL_MAX_CONSECUTIVE_NO_ANSWER=5
CALL_RETRY_INITIAL_MINUTES=5
CALL_RETRY_MULTIPLIER=1.2
CALL_RETRY_MAX_MINUTES=30
RECORDING_READY_POLL_MS=15000
RECORDING_READY_MAX_POLLS=4

# Queue job retry settings are independent from call retry settings.
QUEUE_WORKER_CONCURRENCY=4
QUEUE_POLL_MS=500
QUEUE_LEASE_MS=60000
QUEUE_MAX_ATTEMPTS=8
QUEUE_RETRY_INITIAL_MS=1000
QUEUE_RETRY_MULTIPLIER=2
QUEUE_RETRY_MAX_MS=60000

# Outbound POST to the main platform after both attendance stages are confirmed.
ATTENDANCE_BACKEND_URL=https://your-platform.example.com/api/attendance/call-completed
ATTENDANCE_BACKEND_TOKEN=replace-with-platform-bearer-token
ATTENDANCE_BACKEND_TIMEOUT_MS=15000
